# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Telegram ---
BOT_TOKEN=changeme
WEBHOOK_SECRET=changeme
# Public base URL Telegram will POST updates to, e.g. https://your-tunnel.example.com
WEBHOOK_BASE_URL=http://localhost:8000
# Set to false for local/CI runs with no public URL or real bot token (skips the
# Telegram set_webhook/delete_webhook API calls; the /webhook route still works).
REGISTER_WEBHOOK=true

# --- Postgres (Phase 1+) ---
DATABASE_URL=postgresql+asyncpg://qurbot:qurbot@postgres:5432/qurbot

# --- Redis (Phase 1+) ---
REDIS_URL=redis://redis:6379/0
# Keeps bot conversation state in Redis so an in-progress upload or checkout
# survives a redeploy, and so more than one web replica can serve a user.
# Set false only for local dev without Redis -- durable data (listing drafts,
# uploaded photos) is written to Postgres either way.
FSM_USE_REDIS=true

# --- Reverse geocoding for delivery addresses ---
# Optional. With a key, Yandex is used (much better Uzbek street coverage);
# without one it falls back to keyless Nominatim, which is coarser but works.
# YANDEX_GEOCODER_API_KEY=

# --- LLM fallback (Phase 7+) ---
OPENAI_API_KEY=changeme
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
LLM_ENABLED=true
LLM_DAILY_TOKEN_BUDGET=100000

# --- Admin Web (Phase 8+) ---
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=changeme

# --- Observability (Phase 9+) ---
# Leave unset to disable Sentry entirely -- it only activates with a real DSN.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Customer website (app/web/storefront) ---
# The site is the same product as the bot: visitors sign in with Telegram and
# land on the very users row the bot writes.
WEB_ENABLED=true
# BotFather username (no @) the Login Widget is bound to. Also set the site's
# domain on the bot via BotFather -> /setdomain, or the widget refuses to render.
# TELEGRAM_LOGIN_BOT_USERNAME=qurbot
# Signs session cookies. Unset, it is derived from BOT_TOKEN; set it explicitly
# to keep people signed in across a bot-token rotation.
# WEB_SESSION_SECRET=changeme
WEB_SESSION_MAX_AGE_DAYS=30
# Local-only sign-in form, for developing the site without a bot domain.
# Never enable this in a deployment: it grants any Telegram id on request.
WEB_DEV_LOGIN_ENABLED=false
